{
  "name": "riczone-cookie-guard",
  "version": "1.0.0",
  "license": "MIT",
  "author": "Riczone <riczone.digital@gmail.com>",
  "homepage": "https://riczone.de",
  "repository": {
    "type": "git",
    "url": "https://github.com/RiczoneDigital/riczone-cookie-guard.git"
  },
  "private": true,
  "description": "Lehnt Cookie-Banner automatisch ab und akzeptiert sie auf Whitelist-Seiten (z. B. Payback) automatisch – für Chrome und Firefox (Manifest V3).",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox --mv3",
    "build:chrome": "wxt build -b chrome --mv3",
    "build:firefox": "wxt build -b firefox --mv3",
    "build:all": "npm run build:chrome && npm run build:firefox",
    "package": "npm run build:all && node scripts/package-release.mjs",
    "typecheck": "wxt prepare && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@duckduckgo/autoconsent": "^18.10.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^22.15.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4",
    "wxt": "^0.21.5"
  }
}
